{
  "name": "@atoms/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/parse.test.ts",
    "db:local": "wrangler d1 migrations apply atoms-demo --local",
    "db:remote": "wrangler d1 migrations apply atoms-demo --remote"
  },
  "dependencies": {
    "@atoms/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251110.0",
    "typescript": "^5.9.3",
    "wrangler": "4.159.0"
  }
}
